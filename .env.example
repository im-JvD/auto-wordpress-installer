# Environment variables configuration for WordPress & Docker Stack
# Domain & Admin
DOMAIN_NAME=example.com
CERTBOT_EMAIL=admin@example.com

# Ports configuration (80 is standard HTTP, 443 is standard HTTPS, 8443 for Cloudflare when 443 is occupied)
HTTP_PORT=80
HTTPS_PORT=443

# Database Selection (mariadb:10.11 or mysql:8.0)
DB_IMAGE=mariadb:10.11

# Database Credentials
DB_NAME=wordpress
DB_USER=wp_user
DB_PASSWORD=ChangeThisSecurePassword123!
DB_ROOT_PASSWORD=ChangeThisSecureRootPassword123!

# WordPress Table Prefix
WP_TABLE_PREFIX=wp_
