# Environment variables configuration for WordPress & Docker Stack
# Domain & Admin
DOMAIN_NAME=example.com
CERTBOT_EMAIL=admin@example.com

# Ports configuration (80 is standard HTTP, 443 is standard HTTPS, 2087/8443 for Cloudflare when 443 is occupied)
HTTP_PORT=80
HTTPS_PORT=443

# Web Server Engine (openlitespeed or nginx) & Active Docker Compose Profile (ols or nginx)
WEB_SERVER=openlitespeed
COMPOSE_PROFILES=ols

# OpenLiteSpeed Image (LSPHP 7.4 to 8.3)
OLS_IMAGE=litespeedtech/openlitespeed:latest-lsphp83

# WordPress PHP-FPM Image for Nginx Profile (php7.4 to php8.3)
WP_IMAGE=wordpress:php8.3-fpm-alpine
WP_ENTRYPOINT=docker-entrypoint.sh php-fpm
WP_TABLE_PREFIX=wp_

# Database Selection (mariadb:10.11 or mysql:8.0)
DB_IMAGE=mariadb:10.11

# Database Credentials
DB_NAME=wordpress
DB_USER=wp_user
DB_PASSWORD=ChangeThisSecurePassword123!
DB_ROOT_PASSWORD=ChangeThisSecureRootPassword123!
