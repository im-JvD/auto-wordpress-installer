# ==============================================================================
# OpenLiteSpeed Server Configuration Template
# Managed automatically by setup.sh - Do not edit directly
# ==============================================================================

serverName                ${DOMAIN_NAME}
user                      nobody
group                     nogroup
priority                  0
inMemCacheSize            120M
autoFix503                1
gracefulRestartTimeout    300
mime                      conf/mime.properties
showVersionNumber         0
adminEmails               root@localhost

errorlog logs/error.log {
  logLevel                WARN
  rollingSize             10M
  enableStderrLog         1
}

accesslog logs/access.log {
  rollingSize             10M
  keepDays                30
  compressArchive         0
}

# Native Server-Level Cache Module (LSCache)
module cache {
  ls_enabled              1
  checkPrivateCache       1
  checkPublicCache        1
  maxCacheObjSize         10000000
  maxStaleAge             200
  qsCache                 1
  reqCookieCache          1
  respCookieCache         1
  ignoreReqCacheCtrl      1
  ignoreRespCacheCtrl     0
  enableCache             0
  expireInSeconds         3600
  enablePrivateCache      0
  privateExpireInSeconds  3600
}

# External Application (LiteSpeed PHP - LSAPI)
extprocessor lsphp {
  type                    lsapi
  address                 uds://tmp/lshttpd/lsphp.sock
  maxConns                35
  env                     PHP_LSAPI_CHILDREN=35
  env                     LSAPI_AVOID_FORK=200M
  initTimeout             600
  retryTimeout            0
  persistConn             1
  respBuffer              0
  autoStart               1
  path                    fcgi-bin/lsphp
  backlog                 100
  instances               1
  priority                0
  memSoftLimit            0
  memHardLimit            0
  procSoftLimit           0
  procHardLimit           0
}

scriptHandler {
  add                     lsapi:lsphp php
}

# HTTP Listener on container port 80 (Docker maps host HTTP_PORT here)
listener Default {
  address                 *:80
  secure                  0
  map                     Example *
}

# HTTPS Listener on container port 443 (Docker maps host HTTPS_PORT here)
listener HTTPS {
  address                 *:443
  secure                  1
  keyFile                 /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem
  certFile                /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem
  certChain               1
  sslProtocol             24
  enableQuic              1
  enableHttp3             1
  map                     Example *
}

# Virtual Host Definition
virtualHost Example {
  vhRoot                  /var/www/vhosts/localhost
  configFile              conf/vhosts/Example/vhconf.conf
  allowSymbolLink         1
  enableGzip              1
}
